# config.json holds machine specific paths and is edited on the Windows PC,
# so it stays local. selectors.json IS tracked: it only describes NS Retail's
# controls (no paths, no credentials) and is developed here and pulled there.
config/config.json
*.local.json

# Never commit credentials
.env
*.env
credentials.json

# Logs and exports (the folders stay, their contents do not)
logs/*
!logs/.gitkeep
*.log
*.csv

# Build output
build/*
!build/.gitkeep
dist/
*.spec.bak
*.egg-info/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.vscode/
.idea/
